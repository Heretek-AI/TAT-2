extends RefCounted
## Mobile (Android) quality profile.
##
## Desktop keeps its existing behaviour: every helper returns the desktop values
## unless `OS.has_feature("mobile")` is true (or tests force it on). The mobile
## build project generated by `tools/prepare_mobile_project.py` sets the Mobile
## renderer, ETC2/ASTC import and landscape orientation in project.godot; this
## script only tunes runtime cost.

enum Tier { PERFORMANCE, BALANCED, QUALITY }

const TIER_KEYS: Array[String] = ["performance", "balanced", "quality"]
const TIER_LABELS: Array[String] = ["Performance", "Balanced", "Quality"]
const DESKTOP_MAX_LIGHTS: int = 48
const DESKTOP_HERO_SHADOWS: int = 2

static var _force_mobile: bool = false
## M1: tier cache. Every cap query funnels through current_tier(); without
## this the tree lookup + dict walk in _settings() runs per call (per-frame
## callers pay node lookup + string hash). Invalidated by set_tier() and
## set_force_mobile() — the only writers — so cached reads stay exact.
static var _cached_tier: int = 1
static var _tier_dirty: bool = true


static func is_mobile() -> bool:
	return _force_mobile or OS.has_feature("mobile")


static func set_force_mobile(value: bool) -> void:
	_force_mobile = value
	_tier_dirty = true


## D10: test isolation. _force_mobile is static and persists across scene
## reloads, so suites that toggle it must call this between cases instead
## of leaking the override into the next test.
static func reset_test_state() -> void:
	_force_mobile = false
	_tier_dirty = true


static func tier_from_key(key: String) -> int:
	var idx: int = TIER_KEYS.find(key.to_lower())
	return idx if idx >= 0 else int(Tier.BALANCED)


static func current_tier() -> int:
	if _tier_dirty:
		_cached_tier = tier_from_key(str(_settings().get("mobile_quality", "balanced")))
		_tier_dirty = false
		if _cached_tier < 0 or _cached_tier >= TIER_KEYS.size():
			push_warning("[mobile_profile] current_tier cache out of range: ", _cached_tier, "; falling back to BALANCED")
			_cached_tier = int(Tier.BALANCED)
	return _cached_tier


static func tier_label(tier: int) -> String:
	return TIER_LABELS[clampi(tier, 0, TIER_LABELS.size() - 1)]


## D10: unknown tiers clamp (with a warning, never a silent no-op) and
## non-dictionary save data warns instead of silently dropping the write.
static func set_tier(tier: int, save_system: Node) -> void:
	if save_system == null:
		push_warning("[mobile_profile] set_tier called with null save_system; tier unchanged")
		return
	var data_variant: Variant = save_system.get("data")
	if not (data_variant is Dictionary):
		push_warning("[mobile_profile] set_tier: save data is not a Dictionary; tier unchanged")
		return
	if tier < 0 or tier >= TIER_KEYS.size():
		push_warning("[mobile_profile] set_tier: tier ", tier, " out of range; clamping to ", clampi(tier, 0, TIER_KEYS.size() - 1))
	var data: Dictionary = data_variant
	var settings: Variant = data.get("settings", {})
	if not (settings is Dictionary):
		settings = {}
	var settings_dict: Dictionary = settings
	settings_dict["mobile_quality"] = TIER_KEYS[clampi(tier, 0, TIER_KEYS.size() - 1)]
	data["settings"] = settings_dict
	_tier_dirty = true
	if save_system.has_method("write_save"):
		save_system.call("write_save")


static func max_lights() -> int:
	if not is_mobile():
		return DESKTOP_MAX_LIGHTS
	match current_tier():
		Tier.PERFORMANCE:
			return 12
		Tier.QUALITY:
			return 32
		_:
			return 24


static func hero_shadows() -> int:
	if not is_mobile():
		return DESKTOP_HERO_SHADOWS
	match current_tier():
		Tier.PERFORMANCE:
			return 1
		Tier.QUALITY:
			return 4
		_:
			return 2


static func render_scale() -> float:
	if not is_mobile():
		return 1.0
	match current_tier():
		Tier.PERFORMANCE:
			return 0.7
		Tier.QUALITY:
			return 1.0
		_:
			return 0.85


static func lod_bias() -> float:
	if not is_mobile():
		return 1.0
	match current_tier():
		Tier.PERFORMANCE:
			return 2.5
		Tier.QUALITY:
			return 1.5
		_:
			return 2.0


static func glow_enabled() -> bool:
	if not is_mobile():
		return true
	return current_tier() != Tier.PERFORMANCE


static func target_fps() -> int:
	if not is_mobile():
		return 0
	return 30 if current_tier() == Tier.PERFORMANCE else 60


## Rain-particle scale per tier (W3 companion): Performance 0.35 /
## Balanced 0.6 / Quality 0.8 of the desktop amount. Desktop keeps 1.0.
## Ratios are perf policy, not extracted data.
static func rain_scale() -> float:
	if not is_mobile():
		return 1.0
	match current_tier():
		Tier.PERFORMANCE:
			return 0.35
		Tier.QUALITY:
			return 0.8
		_:
			return 0.6


## Applies viewport scaling and frame cap. M2: early-out on desktop — the
## old path forced Engine.max_fps = 0 (stomping any prior cap) and enabled
## the bilinear 3D scaler at 1.0x (still a scaler pass) on every call.
static func apply_runtime(tree: SceneTree) -> void:
	if tree == null:
		return
	if not is_mobile():
		return
	Engine.max_fps = target_fps()
	var win: Window = tree.root
	if win == null:
		return
	var scale: float = render_scale()
	win.scaling_3d_scale = scale
	win.scaling_3d_mode = Viewport.SCALING_3D_MODE_BILINEAR


static func apply_environment(env: Environment) -> void:
	if env == null:
		return
	if not is_mobile():
		return
	env.glow_enabled = glow_enabled()
	if env.glow_enabled:
		# PG-1: soften, never amplify. minf keeps earlier pipeline caps
		# intact (e.g. the Thieves' Den 0.32 RD cap from the weather
		# preset / level post-process) instead of stomping them to 0.45.
		env.glow_intensity = minf(env.glow_intensity, 0.45)
		env.glow_bloom = minf(env.glow_bloom, 0.12)


static func _settings() -> Dictionary:
	var tree: SceneTree = Engine.get_main_loop() as SceneTree
	if tree == null:
		return {}
	var save_system: Node = tree.root.get_node_or_null("SaveSystem")
	if save_system == null:
		return {}
	var data_variant: Variant = save_system.get("data")
	if not (data_variant is Dictionary):
		return {}
	var data: Dictionary = data_variant
	var settings: Variant = data.get("settings", {})
	if settings is Dictionary:
		return settings
	return {}
