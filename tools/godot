#!/usr/bin/env bash
# Prefer a native Godot 4.7.2 binary over the Flatpak. Fedora's host NVIDIA
# driver can outrun the Flatpak GL extension, in which case the Flatpak
# silently falls back to llvmpipe (software Vulkan). A native binary uses the
# host Vulkan driver and avoids that mismatch.
set -euo pipefail

if [ -n "${GODOT_BIN:-}" ] && [ -x "${GODOT_BIN}" ]; then
  exec "${GODOT_BIN}" "$@"
fi

for candidate in \
  "${HOME}/.local/opt/godot-4.7.2/Godot_v4.7.2-stable_linux.x86_64" \
  "${HOME}/.local/bin/godot4" \
  "${HOME}/.local/bin/godot" \
  "/usr/local/bin/godot4" \
  "/usr/bin/godot4" \
  "/usr/bin/godot"; do
  if [ -x "${candidate}" ]; then
    exec "${candidate}" "$@"
  fi
done

if command -v flatpak >/dev/null 2>&1; then
  exec flatpak run org.godotengine.Godot "$@"
fi

echo "tools/godot: no native Godot or Flatpak found" >&2
exit 127
