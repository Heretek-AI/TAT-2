# Extracted game content - PRIVATE, never commit
extracted/
game/assets/ue/
game/data/generated/
game/i18n/generated/
# Review baker output is derived from extracted content: never commit it.
# The review_mode scene/script and addon sources stay tracked.
game/scenes/review/
# Godot
game/.godot/
*.import.bak
# .NET
tools/**/bin/
tools/**/obj/
tools/bin/
# misc
*.usmap
__pycache__/
tools/ue4ss/cache/
tools/ue4ss/output/
# QA harness sources are tracked (the E2E gate reads them); captures and
# build artifacts are not.
build/*
!build/qa/
build/qa/*
!build/qa/**/*.gd
!build/qa/**/*.sh
!build/qa/**/*.py
# P4.5: the measured KF27 beam contract is a tracked QA fixture (the headless
# beam probe and p0b_roi_stats.py both read it); capture PNGs/manifests stay
# ignored by the rules above.
!build/qa/kf27_beam_reference.json
# Phase 3 test-manifest/errscan: the explicit retired-test list and the engine
# error allowlist are tracked gate inputs (gate_manifest.py and e2e_errscan.sh
# fail closed without them), not build artifacts.
!build/qa/retired_tests.txt
!build/qa/e2e_errscan_allowlist.txt
.agents/
.claude/
.claude-flow/
.omo/
extracted.bak/
game/data/generated.bak/
extracted.bak/*
game/data/generated.bak/*
# stray 0-byte `-1` shell artifact (never tracked; Phase 3 hygiene)
/-1

# Fleet-managed Agent Skills are tracked
!.agents/
