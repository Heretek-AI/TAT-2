# codebase-memory index whitelist (gitignore syntax).
# Index hand-written source only; never the extracted/generated trees.
/*
!/.gitignore
!/.cbmignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/Makefile

!/game/
/game/*
!/game/src/
!/game/tests/
!/game/addons/
!/game/scenes/
/game/scenes/review/
!/game/data/
/game/data/*
!/game/data/expansion/

!/tools/
!/docs/

# Explicit heavy-tree defenses. Belt and braces: these are already covered (or
# should be) above, but keep them after the whitelist so later ignore rules
# win. Nothing here may ever be indexed.
/game/scenes/review/
/game/data/generated/
/game/.godot/
/extracted/
/build/
/tools/**/bin/
/tools/**/obj/
/tools/ue4ss/cache/
/tools/__pycache__/
